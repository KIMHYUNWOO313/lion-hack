rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /userRecordings/{uid}/sessions/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /meetings/{roomId}/sessions/{sessionId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      match /chat/{messageId} {
        allow read, create: if request.auth != null;
      }
      match /transcripts/{transcriptId} {
        allow read, create, update: if request.auth != null;
      }
    }
  }
}

service firebase.storage {
  match /b/{bucket}/o {
    match /recordings/{roomId}/{sessionId}/{participantId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 500 * 1024 * 1024
        && request.resource.contentType.matches('video/webm.*|audio/webm.*');
    }
  }
}
